# Core runtime
NODE_ENV=production
PORT=8080
POLL_INTERVAL_MINUTES=1
ALERT_SCORE_THRESHOLD=8
DATABASE_URL=./data/monitor.sqlite

# Telegram
# Token from @BotFather. Users subscribe by opening the bot and sending /start (stored in DB). Send /stop to unsubscribe.
# Optional legacy: TELEGRAM_CHAT_ID = your user id, group id, or channel id — also receives alerts alongside /start subscribers. NOT the bot id (not the number before ":" in the token).
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML

# Optional behavior toggles
ENABLE_SENTIMENT=false
ENABLE_PLAYWRIGHT_FALLBACK=true
FETCH_CONCURRENCY=6
REQUEST_TIMEOUT_MS=12000
REQUEST_RETRY_COUNT=3
RATE_LIMIT_PER_SECOND=2

# Proxy support (optional)
HTTP_PROXY=
HTTPS_PROXY=

# User-agent rotation
USER_AGENTS_JSON=["Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0.0.0 Safari/537.36","Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/605.1.15 Version/17.0 Safari/605.1.15"]
